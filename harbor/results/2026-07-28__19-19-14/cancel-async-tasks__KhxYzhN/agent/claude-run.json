ncelledError raised by the ones we just cancelled.\n    await asyncio.gather(*running, return_exceptions=True)\n"}]},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":723,"cache_read_input_tokens":4694,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":723},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6a14cf40-c945-4660-9560-e33dc5661dc1","uuid":"ef098b6a-5512-4f2d-8e4e-4b6d335b04d4","request_id":"req_011CdUx44h2A6Pzq3KpQiMUz","tool_use_meta":[{"id":"toolu_01DUuSkbAsHkzpRBk7iVD3Nk","display_name":"Edit","server_display_name":"lemoncrow"}]}
