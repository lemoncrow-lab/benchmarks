{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_011CdV1Vf5HZfCwgeLKFSBkD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01U3JLKGGcxrqLbPM5maL7cq","name":"mcp__lc__edit","input":{"edits":[{"path":"/app/parallel_linear.py","replace":true,"new":"import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.distributed as dist\n\n\ndef _world_rank():\n    if dist.is_available() and dist.is_initialized():\n        return dist.get_world_size(), dist.get_rank()\n    return 1, 0\n\n\nclass _AllGatherLastDim(torch.autograd.Function):\n    \"\"\"Differentiable all_gather with concatenation along the last dim.\"\"\"\n\n    @staticmethod\n    def forward(ctx, x):\n        world, rank = _world_rank()\n        ctx.world = world\n        ctx.rank = rank\n        if world == 1:\n            return x\n        x = x.contiguous()\n        gathered = [torch.empty_like(x) for _ in range(world)]\n        dist.all_gather(gathered, x)\n        # keep local shard connected to the autograd graph\n        gathered[rank] = x\n        return torch.cat(gathered, dim=-1)\n\n    @staticmethod\n    def backward(ctx, grad_output):\n        world = ctx.world\n        rank = ctx.rank\n        if world == 1:\n            return grad_output\n        chunks = grad_output.chunk(world, dim=-1)\n        return chunks[rank].contiguous()\n\n\nclass _AllReduceSum(torch.autograd.Function):\n    \"\"\"Differentiable all_reduce (sum). Backward is identity.\"\"\"\n\n    @staticmethod\n    def forward(ctx, x):\n        world, _ = _world_rank()\n        if world == 1:\n            return x\n        x = x.clone()\n        dist.all_reduce(x, op=dist.ReduceOp.SUM)\n        return x\n\n    @staticmethod\n    def backward(ctx, grad_output):\n        return grad_output\n\n\nclass ColumnParallelLinear(torch.nn.Module):\n    def __init__(self, in_features, out_features, bias, master_weight):\n        super().__init__()\n        self.in_features = in_features\n        self.out_features = out_features\n        world, rank = _world_rank()\n        assert out_features % world == 0, \\\n            \"out_features must be divisible by world_size\"\n        self.out_features_per_partition = out_features // world\n\n        # master_weight has shape [out_features, in_features] (nn.Linear layout).\n        # Column parallel splits along the output dimension.\n        start = rank * self.out_features_per_partition\n        end = start + self.out_features_per_partition\n        w_shard = master_weight[start:end, :].clone().detach()\n        self.weight = nn.Parameter(w_shard)\n\n        if bias:\n            b = torch.zeros(self.out_features_per_partition,\n                            dtype=self.weight.dtype,\n                            device=self.weight.device)\n            self.bias = nn.Parameter(b)\n        else:\n            self.register_parameter(\"bias\", None)\n\n    def forward(self, input_):\n        local_out = F.linear(input_, self.weight, self.bias)\n        return _AllGatherLastDim.apply(local_out)\n\n\nclass RowParallelLinear(torch.nn.Module):\n    def __init__(self, in_features, out_features, bias, master_weight):\n        super().__init__()\n        self.in_features = in_features\n        self.out_features = out_features\n        world, rank = _world_rank()\n        assert in_features % world == 0, \\\n            \"in_features must be divisible by world_size\"\n        self.in_features_per_partition = in_features // world\n\n        # master_weight has shape [out_features, in_features] (nn.Linear layout).\n        # Row parallel splits along the input dimension.\n        start = rank * self.in_features_per_partition\n        end = start + self.in_features_per_partition\n        w_shard = master_weight[:, start:end].clone().detach()\n        self.weight = nn.Parameter(w_shard)\n\n        if bias:\n            b = torch.zeros(out_features,\n                            dtype=self.weight.dtype,\n                            device=self.weight.device)\n            self.bias = nn.Parameter(b)\n        else:\n            self.register_parameter(\"bias\", None)\n\n    def forward(self, input_):\n        # input_ is already scattered along the last dimension.\n        local_out = F.linear(input_, self.weight)\n        out = _AllReduceSum.apply(local_out)\n        if self.bias is not None:\n            out = out + self.bias\n        return out\n"}]},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":841,"cache_read_input_tokens":7940,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":841},"output_tokens":54,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5404e4c7-d545-476c-846f-c33ccf695676","uuid":"09b840cc-3387-4d3d-a5fc-1f376adfd7bb","request_id":"req_011CdV1VdnQ4DHNUvQUe3DGL","tool_use_meta":[{"id":"toolu_01U3JLKGGcxrqLbPM5maL7cq","display_name":"Edit","server_display_name":"lemoncrow"}]}
