+def _semantic_overlap(
+    findings: Sequence[ConfirmedFinding], files: Mapping[str, frozenset[str]] | None = None
+) -> tuple[tuple[str, ...], ...]:
+    """Groups of findings that may be one defect reported twice.
+
+    The Reader's groups are findings over exactly the same category and targets. A pull request review (*files*:
+    ``{finding id: the files its targets are in}``) has many calls over different slices of one change, so two calls
+    that found the same defect name different targets: its groups are the findings that share a file.
+    """
+
+    if files is not None:
+        parent = {finding.id: finding.id for finding in findings}
+
+        def root(item: str) -> str:
+            while parent[item] != item:
+                parent[item] = parent[parent[item]]
+                item = parent[item]
+            return item
+
+        first_in_file: dict[str, str] = {}
+        for finding in findings:
+            for path in sorted(files.get(finding.id, ())):
+                if path in first_in_file:
+                    parent[root(finding.id)] = root(first_in_file[path])
+                else:
+                    first_in_file[path] = finding.id
+        members: dict[str, list[str]] = {}
+        for finding in findings:
+            members.setdefault(root(finding.id), []).append(finding.id)
+        return tuple(tuple(ids) for ids in members.values() if len(ids) > 1)
