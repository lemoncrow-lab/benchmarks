+        verdicts = [
+            {
+                "finding_id": row["finding_id"],
+                "verdict": "drop" if row["title"] in self.refute else "keep",
+                "reason": "the code handles it" if row["title"] in self.refute else "it holds",
+            }
+            for row in rows
+        ]
+        usage = ModelCallUsage(calls=1, input_tokens=self.input_tokens, output_tokens=self.output_tokens)
+        return StructuredExecution(result={"verdicts": verdicts}, driver="openai", model=self.model, usage=usage)
