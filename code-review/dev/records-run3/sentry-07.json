      "response": {
        "category": "correctness",
        "consequence": "Any consumer of `queued` sees a wrong time that can be hours or days old. The same value is serialized into every task payload through `to_dict`.",
        "evidence_refs": [
          "source:new:src/sentry/integrations/services/assignment_source.py@sha256:885ab5f3b8ef5398cf84e90112d9352978908c663d9034ef89e7ed4eccfdfa0e"
        ],
        "explanation": "`queued: datetime = timezone.now()` is a dataclass default, so it is evaluated once when the module is imported. Every AssignmentSource built with `from_integration` gets the same stale timestamp, namely the process start time. It does not record when the assignment was queued. It needs `field(default_factory=timezone.now)`.",
        "lines": {
          "end_line": 18,
          "start_line": 18
        },
        "other_findings": [],
        "prior_findings": [],
        "replacement": {
          "end_line": 18,
          "original": "    queued: datetime = timezone.now()",
          "start_line": 18,
          "text": "    queued: datetime = field(default_factory=timezone.now)"
        },
